    diff_coast_level: int
    front_bump_damper_level: int
    front_rebound_damper_level: int
    rear_bump_damper_level: int
    rear_rebound_damper_level: int
    is_ignition_on: bool
    is_pit_limiter_on: bool
    active_performance_mode: int
